import "nipaddr"
import "ntest"

fn test_ipv4_address() {
    let a = nipaddr.ipv4("192.168.1.1")
    ntest.assert_eq(nipaddr.kind(a), "ipv4")
    ntest.assert_eq(nipaddr.version(a), 4)
    ntest.assert_eq(nipaddr.to_string(a), "192.168.1.1")
    ntest.assert_true(nipaddr.is_private(a))
    nipaddr.close(a)
}

fn test_ipv6_address() {
    let a = nipaddr.ipv6("2001:db8::1")
    ntest.assert_eq(nipaddr.kind(a), "ipv6")
    ntest.assert_eq(nipaddr.version(a), 6)
    ntest.assert_true(nipaddr.compressed(a).contains("::"))
    nipaddr.close(a)
}

fn test_auto_address() {
    let v4 = nipaddr.address("10.0.0.1")
    let v6 = nipaddr.address("::1")
    ntest.assert_eq(nipaddr.version(v4), 4)
    ntest.assert_eq(nipaddr.version(v6), 6)
    nipaddr.close(v4)
    nipaddr.close(v6)
}

fn test_network_strict() {
    let ok = nipaddr.network("192.168.0.0/24", true)
    ntest.assert_eq(nipaddr.kind(ok), "ipv4_network")
    ntest.assert_eq(nipaddr.prefixlen(ok), 24)
    nipaddr.close(ok)

    let bad = nipaddr.network("192.168.0.1/24", true)
    ntest.assert_true(bad.kind == "nipaddr_error" || nipaddr.kind(bad) == nil)
}

fn test_network_loose() {
    let n = nipaddr.network("192.168.1.0/24", false)
    ntest.assert_eq(nipaddr.to_string(nipaddr.network_address(n)), "192.168.1.0")
    nipaddr.close(n)
}

fn test_contains() {
    let net = nipaddr.network("10.0.0.0/8")
    let inside = nipaddr.ipv4("10.1.2.3")
    let outside = nipaddr.ipv4("192.168.0.1")
    ntest.assert_true(nipaddr.contains(net, inside))
    ntest.assert_false(nipaddr.contains(net, outside))
    nipaddr.close(net)
    nipaddr.close(inside)
    nipaddr.close(outside)
}

fn test_interface() {
    let iface = nipaddr.interface("172.16.5.10/16")
    ntest.assert_eq(nipaddr.kind(iface), "ipv4_interface")
    let ip = nipaddr.ip(iface)
    ntest.assert_eq(nipaddr.to_string(ip), "172.16.5.10")
    let net = nipaddr.network_of(iface)
    ntest.assert_eq(nipaddr.prefixlen(net), 16)
    nipaddr.close(iface)
    nipaddr.close(ip)
    nipaddr.close(net)
}

fn test_hosts_slash_30() {
    let n = nipaddr.network("192.0.2.0/30")
    let hosts = nipaddr.hosts(n)
    ntest.assert_eq(len(hosts), 2)
    nipaddr.close(n)
}

fn test_summarize_range() {
    let first = nipaddr.ipv4("192.168.0.0")
    let last = nipaddr.ipv4("192.168.0.255")
    let nets = nipaddr.summarize_range(first, last)
    ntest.assert_eq(len(nets), 1)
    ntest.assert_eq(nipaddr.to_string(nets[0]), "192.168.0.0/24")
    nipaddr.close(first)
    nipaddr.close(last)
    nipaddr.close(nets[0])
}

fn test_collapse() {
    let a = nipaddr.network("192.168.0.0/25")
    let b = nipaddr.network("192.168.0.128/25")
    let merged = nipaddr.collapse([a, b])
    ntest.assert_eq(len(merged), 1)
    ntest.assert_eq(nipaddr.prefixlen(merged[0]), 24)
    nipaddr.close(a)
    nipaddr.close(b)
    nipaddr.close(merged[0])
}

fn test_contains_many() {
    let net = nipaddr.network("10.0.0.0/8")
    let addrs = [nipaddr.ipv4("10.0.0.1"), nipaddr.ipv4("8.8.8.8"), nipaddr.ipv4("10.255.255.255")]
    let flags = nipaddr.contains_many(net, addrs)
    ntest.assert_eq(flags[0], true)
    ntest.assert_eq(flags[1], false)
    ntest.assert_eq(flags[2], true)
    nipaddr.close(net)
    nipaddr.close(addrs[0])
    nipaddr.close(addrs[1])
    nipaddr.close(addrs[2])
}

fn test_validators() {
    ntest.assert_true(nipaddr.valid_address("1.1.1.1"))
    ntest.assert_false(nipaddr.valid_address("999.1.1.1"))
    ntest.assert_true(nipaddr.valid_network("10.0.0.0/8"))
    ntest.assert_false(nipaddr.valid_network("10.0.0.1/8", true))
    ntest.assert_true(nipaddr.valid_interface("10.0.0.1/32"))
}

fn test_reverse_ptr() {
    let a = nipaddr.ipv4("1.2.3.4")
    ntest.assert_eq(nipaddr.reverse_ptr(a), "4.3.2.1.in-addr.arpa")
    nipaddr.close(a)
}

fn test_add_compare() {
    let a = nipaddr.ipv4("192.168.0.1")
    let b = nipaddr.add(a, 1)
    ntest.assert_eq(nipaddr.to_string(b), "192.168.0.2")
    ntest.assert_eq(nipaddr.compare(a, b), -1)
    nipaddr.close(a)
    nipaddr.close(b)
}

fn test_overlaps_subnet() {
    let big = nipaddr.network("10.0.0.0/8")
    let small = nipaddr.network("10.1.0.0/16")
    ntest.assert_true(nipaddr.overlaps(big, small))
    ntest.assert_true(nipaddr.subnet_of(small, big))
    ntest.assert_true(nipaddr.supernet_of(big, small))
    nipaddr.close(big)
    nipaddr.close(small)
}

fn test_broadcast_netmask() {
    let n = nipaddr.network("192.168.1.0/24")
    ntest.assert_eq(nipaddr.to_string(nipaddr.broadcast_address(n)), "192.168.1.255")
    ntest.assert_eq(nipaddr.to_string(nipaddr.netmask(n)), "255.255.255.0")
    nipaddr.close(n)
}

fn test_invalid_handle() {
    let bad = nipaddr.to_string(999999)
    ntest.assert_true(bad.kind == "nipaddr_error" || nipaddr.kind(bad) == nil)
}
