// ntar integration tests — run: niao run tests/ntar.niao
import "ntar"
import "ntest"
import "nfs"
import "nos"
import "io"

fn mk_base() {
    let base = nfs.temp_dir() + "/ntest_ntar_" + str(nos.getpid())
    if nos.exists(base) {
        nfs.rmtree(base)
    }
    nos.makedirs(base)
    return base
}

fn test_pack_unpack_tar_gz() {
    let base = mk_base()
    let src = base + "/src"
    let dst = base + "/dst"
    let arc = base + "/pkg.tar.gz"
    nos.makedirs(src + "/sub")
    io.write_file(src + "/sub/hello.txt", "hello-tar")

    ntar.pack_tree(src, arc, {arcname: "root"})
    ntest.assert_true(ntar.is_tar(arc))
    ntest.assert_eq(ntar.detect(arc), "gz")

    let names = ntar.unpack(arc, dst)
    ntest.assert_true(len(names) > 0)
    ntest.assert_eq(io.read_file(dst + "/root/sub/hello.txt"), "hello-tar")
    nfs.rmtree(base)
}

fn test_open_read_write() {
    let base = mk_base()
    let arc = base + "/data.tar"
    let out = base + "/out"

    let w = ntar.open(arc, {mode: "w"})
    ntar.add_bytes(w.handle, "a.txt", [65, 66, 67])
    ntar.add_bytes(w.handle, "dir/b.txt", [68])
    ntar.close(w.handle)

    let r = ntar.open(arc)
    ntest.assert_true(ntar.contains(r.handle, "a.txt"))
    ntest.assert_eq(ntar.get(r.handle, "a.txt").size, 3)
    let data = ntar.read(r.handle, "a.txt")
    ntest.assert_eq(len(data), 3)
    ntest.assert_eq(ntar.detect(arc), "none")

    nos.makedirs(out)
    ntar.extract_all(r.handle, out)
    ntest.assert_eq(io.read_file(out + "/a.txt"), "ABC")
    ntar.close(r.handle)
    nfs.rmtree(base)
}

fn test_tar_zst() {
    let base = mk_base()
    let src = base + "/src"
    let arc = base + "/pkg.tar.zst"
    nos.makedirs(src)
    io.write_file(src + "/z.txt", "zstd")

    ntar.pack_tree(src, arc, {compression: "zst", level: 3})
    ntest.assert_eq(ntar.detect(arc), "zst")

    let dst = base + "/dst"
    ntar.unpack(arc, dst)
    ntest.assert_eq(io.read_file(dst + "/z.txt"), "zstd")
    nfs.rmtree(base)
}

fn test_members_iterator() {
    let base = mk_base()
    let arc = base + "/iter.tar"
    let w = ntar.open(arc, {mode: "w"})
    ntar.add_bytes(w.handle, "one", [1])
    ntar.add_bytes(w.handle, "two", [2])
    ntar.close(w.handle)

    let r = ntar.open(arc)
    let a = ntar.next(r.handle)
    ntest.assert_eq(a.name, "one")
    let b = ntar.next(r.handle)
    ntest.assert_eq(b.name, "two")
    let c = ntar.next(r.handle)
    ntest.assert_eq(c, nil)
    ntar.rewind(r.handle)
    ntest.assert_eq(ntar.next(r.handle).name, "one")
    ntar.close(r.handle)
    nfs.rmtree(base)
}

fn test_create_multi() {
    let base = mk_base()
    let a = base + "/a.txt"
    let bdir = base + "/b"
    let arc = base + "/multi.tar.gz"
    io.write_file(a, "A")
    nos.makedirs(bdir)
    io.write_file(bdir + "/inner.txt", "B")

    ntar.create([a, bdir], arc, {compression: "gz"})
    let dst = base + "/out"
    let names = ntar.unpack(arc, dst)
    ntest.assert_true(len(names) >= 2)
    nfs.rmtree(base)
}

fn test_unsafe_extract_rejected() {
    let base = mk_base()
    let arc = base + "/evil.tar"
    let w = ntar.open(arc, {mode: "w"})
    // tar crate may normalize; test that missing member returns error object
    ntar.add_bytes(w.handle, "safe.txt", [1])
    ntar.close(w.handle)

    let r = ntar.open(arc)
    let got = ntar.get(r.handle, "missing.bin")
    ntest.assert_true(type(got) == "ntar_error")
    ntar.close(r.handle)
    nfs.rmtree(base)
}

fn main() {
    test_pack_unpack_tar_gz()
    test_open_read_write()
    test_tar_zst()
    test_members_iterator()
    test_create_multi()
    test_unsafe_extract_rejected()
    print("ntar: all tests passed")
}
