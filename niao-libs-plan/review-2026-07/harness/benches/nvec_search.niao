// Measures nvec cosine search -> targets PERFORMANCE.md #1 (precompute norms + SIMD dot).
// TEMPLATE: nvec's exact builtin names were not fully enumerated in the review pass.
// Verify the add/search API against crates/niao_runtime/src/nvec/ and adjust.
import "nvec"
import "nrand"
fn main() {
    nrand.seed(1)
    let idx = nvec.new_index(64)          // dim=64  (verify name)
    let n = 0
    while n < 2000 {
        let v = nrand.gen_float(64)       // 64 random floats (verify)
        nvec.add(idx, "id" + str(n), v)   // verify name
        n = n + 1
    }
    let q = nrand.gen_float(64)
    let acc = 0
    let i = 0
    while i < 2000 {
        let hits = nvec.search(idx, q, 10) // top-10 (verify)
        acc = acc + len(hits)
        i = i + 1
    }
    print(acc)
}
