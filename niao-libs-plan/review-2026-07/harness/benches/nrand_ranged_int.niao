// Measures nrand ranged-int throughput -> targets PERFORMANCE.md #5 (Lemire bounded ints).
// If `nrand.int` differs in your build, adjust the call and re-run.
import "nrand"
fn main() {
    nrand.seed(42)
    let acc = 0
    let i = 0
    while i < 2000000 {
        acc = (acc + nrand.int(0, 1000)) % 1000000007
        i = i + 1
    }
    print(acc)
}
