// Batch membership hot path — parallel contains_many over 10k addresses.
import "nipaddr"

fn main() {
    let net = nipaddr_network("10.0.0.0/8")
    let addrs = []
    let i = 0
    while i < 10000 {
        addrs.push(nipaddr_ipv4("10." + str(i % 256) + "." + str((i / 256) % 256) + "." + str(i % 254 + 1)))
        i = i + 1
    }
    let rounds = 50
    let r = 0
    while r < rounds {
        let flags = nipaddr_contains_many(net, addrs)
        let _ = len(flags)
        r = r + 1
    }
    print(len(addrs), "addrs x", rounds, "rounds")
}
