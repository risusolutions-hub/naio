// nsanitize hot-path bench — run via benchmarks/harness/run_bench.py
import "nsanitize"

const SAMPLE = "<p>Hello <b>world</b>!</p><script>alert(1)</script><a href=\"javascript:x\">bad</a>"

fn main() {
    let i = 0
    while i < 3000 {
        let _ = nsanitize.clean(SAMPLE)
        i = i + 1
    }
    let j = 0
    while j < 2000 {
        let _ = nsanitize.strip(SAMPLE)
        j = j + 1
    }
    let h = nsanitize.compile({tags: ["p", "b", "a"], protocols: ["http", "https"]})
    let k = 0
    while k < 5000 {
        let _ = nsanitize.apply(h, SAMPLE)
        k = k + 1
    }
    nsanitize.close(h)
    let docs = [SAMPLE, SAMPLE, SAMPLE, SAMPLE]
    let m = 0
    while m < 500 {
        let _ = nsanitize.parallel_clean(docs, {threads: 4})
        m = m + 1
    }
    print(1)
}
