// BigInt standard library showcase (native builtins when wired).
// Run:  niao run examples/bignum_demo.niao
//
// Demonstrates VM bigint promotion via overflow — no oversized int literals.

fn main() {
    print("== VM bigint promotion ==")
    let x = 9223372036854775807 + 9223372036854775807
    print(type(x))
    print(x > 9223372036854775807)

    print("== factorial ==")
    let f50 = super_boom_factorial(50)
    print(f50)

    print("== large mul via overflow ==")
    let a = 9223372036854775807 * 9223372036854775807
    let b = a + 9223372036854775807
    print(a * b)
    print(a / b)
    print(a % b)

    print("== chained promotion ==")
    let c = super_boom_factorial(20) * super_boom_factorial(15)
    print(c)

    print("bignum demo done")
}
