// Random number standard library showcase.
// Run: niao run examples/rand_demo.niao
import "nrand"

fn main() {
    print("== seeded int range ==")
    nrand_seed(42)
    print(nrand_int(1, 100))
    print(nrand_int(1, 100))

    print("== reproducibility ==")
    let a = nrand_new_gen(99)
    let b = nrand_new_gen(99)
    print(nrand_gen_int(a, 0, 999999999999))
    print(nrand_gen_int(b, 0, 999999999999))

    print("== float ==")
    print(nrand_float())

    print("== shuffle & choose ==")
    let items = [1, 2, 3, 4, 5]
    nrand_shuffle(items)
    print(items)
    print(nrand_choice(items))

    print("== os entropy ==")
    nrand_seed(0)
    print(nrand_int(0, 1000))
    nrand_close_gen(a)
    nrand_close_gen(b)
    print("rand demo done")
}
