// nopenapi demo — ahiru routes → OpenAPI 3 → typed Niao client stub
import "nopenapi"

let routes = [
    {method: "GET", path: "/health", summary: "Liveness"},
    {method: "GET", path: "/users/:id", permission: "users.read", summary: "Get user"},
    {method: "POST", path: "/users", body: {name: "Ada", email: "ada@example.com"}},
]

let doc = nopenapi.from_ahiru(routes, {
    title: "Demo API",
    version: "1.0.0",
    description: "Generated by nopenapi",
})

nopenapi.add_server(doc, "http://127.0.0.1:8080", "local")
print(nopenapi.to_json(doc, true))
print("--- stub ---")
print(nopenapi.client_stub(doc, {base_url: "http://127.0.0.1:8080", module: "demo_api"}))
nopenapi.close(doc)
