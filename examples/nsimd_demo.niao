// nsimd demo — autovectorized packed-array kernels.
// Run: niao run examples/nsimd_demo.niao
import "nsimd"
import "ncl"

fn main() {
    print("=== nsimd sum / dot ===")
    let a = ncl.array([1, 2, 3, 4, 5, 6, 7, 8])
    let b = ncl.array([8, 7, 6, 5, 4, 3, 2, 1])
    print("sum(a):", nsimd.sum(a))
    print("dot(a,b):", nsimd.dot(a, b))

    print("=== element-wise ===")
    print("add:", nsimd.add(a, b))
    print("mul:", nsimd.mul(a, b))
    print("scale x2:", nsimd.scale(a, 2))
    print("abs:", nsimd.abs(ncl.array([-3, 0, 5])))

    print("=== min / max ===")
    print("min:", nsimd.min(a))
    print("max:", nsimd.max(a))

    print("=== float ===")
    let f = ncl.array([1.5, 2.5, 3.5])
    print("float sum:", nsimd.sum(f))
    print("float dot:", nsimd.dot(f, ncl.array([1.0, 1.0, 1.0])))
}
