// npar demo — rayon parallel packed-array ops.
// Run: niao run examples/npar_demo.niao
import "npar"
import "ncl"

fn main() {
    print("=== thread pool ===")
    print("default threads:", npar.threads())
    print("set_threads(2):", npar.set_threads(2))
    print("active threads:", npar.threads())

    print("=== parallel int ops ===")
    let xs = ncl.array([1, 2, 3, 4, 5, 6, 7, 8])
    let ys = ncl.array([10, 20, 30, 40, 50, 60, 70, 80])
    print("sum:", npar.sum(xs))
    print("add:", npar.add(xs, ys))
    print("mul:", npar.mul(xs, ncl.array([2, 2, 2, 2, 2, 2, 2, 2])))
    print("map double:", npar.map(xs, "double"))
    print("dot:", npar.dot(xs, ys))

    print("=== parallel float ===")
    let fa = ncl.array([1.0, 2.0, 3.0, 4.0])
    print("float sum:", npar.sum(fa))
    print("float map sqrt:", npar.map(fa, "sqrt"))
}
