// npace demo — adaptive loop pacing by level / temp / load.
// Run: niao run examples/npace_demo.niao
import "npace"

fn main() {
    print("=== delays table ===")
    let d = npace.delays()
    print(d)

    print("=== set / level / sleep_ms ===")
    npace.set_level(0)
    print("level:", npace.level(), "ms:", npace.sleep_ms())
    npace.set_level(2)
    print("level:", npace.level(), "ms:", npace.sleep_ms())

    print("=== tick (sleep current delay) ===")
    npace.set_level(1)
    print("slept:", npace.tick(), "ms")

    print("=== from_temp ===")
    print(npace.from_temp(20, 100))    // 0
    print(npace.from_temp(40, 100))    // 1
    print(npace.from_temp(60, 100))    // 2
    print(npace.from_temp(80, 100))    // 3

    print("=== from_load ===")
    print(npace.from_load(10))         // 0
    print(npace.from_load(30))         // 1
    print(npace.from_load(60))         // 2
    print(npace.from_load(90))         // 3

    print("=== paced loop sketch ===")
    npace.set_level(npace.from_load(55))
    for i in 0..3 {
        npace.tick()
        print("step", i, "at level", npace.level())
    }

    npace.set_level(0)
    print("npace demo done")
}
